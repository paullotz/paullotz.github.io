---
import Layout from '../layouts/Layout.astro';
import ArticleTable from '../components/ArticleTable.astro';
import { loadBooksRead, loadReadingList, loadAllArticles } from '../lib/books';

const [booksRead, readingList, articles] = await Promise.all([
  loadBooksRead(),
  loadReadingList(),
  loadAllArticles(),
]);

const totalBooksCount = booksRead.length + readingList.length;
---
<Layout activeTab="articles" booksCount={totalBooksCount} articlesCount={articles.length}>
  <div class="space-y-6">
    <header class="space-y-1 border-b border-zinc-800 pb-4">
      <h1 class="text-2xl font-bold tracking-tight text-white">Articles &amp; Essays</h1>
      <p class="text-xs text-zinc-400 leading-relaxed">
        Technical writeups, architectural deep dives, and engineering essays.
      </p>
    </header>

    <ArticleTable articles={articles} />
  </div>
</Layout>
