---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { bookSlug, loadBooksRead, loadReadingList, loadAllArticles } from '../../lib/books';

export async function getStaticPaths() {
  const [booksRead, readingList] = await Promise.all([
    getCollection('books-read'),
    getCollection('reading-list'),
  ]);
  return [...booksRead, ...readingList].map((book) => ({
    params: { slug: bookSlug(book) },
    props: { id: book.id, collection: book.collection },
  }));
}

const { id, collection } = Astro.props;
const [entry] = await getCollection(collection, ({ id: entryId }) => entryId === id);
if (!entry) throw new Error(`Book not found: ${String(id)}`);
const { Content } = await render(entry);
const book = entry.data;

const [booksRead, readingList, articles] = await Promise.all([
  loadBooksRead(),
  loadReadingList(),
  loadAllArticles(),
]);
const totalBooksCount = booksRead.length + readingList.length;
const hasBody = entry.body && entry.body.trim().length > 0;
---
<Layout
  activeTab="books"
  booksCount={totalBooksCount}
  articlesCount={articles.length}
  title={`${book.title} | Paul L.`}
  description={`Notes on ${book.title} by ${book.author}.`}
>
  <article class="space-y-8">
    <div>
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs text-blue-400 hover:text-blue-300 hover:underline"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
        <span>Back to list</span>
      </a>
    </div>

    <header class="space-y-3 border-b border-zinc-800 pb-6">
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="px-2 py-0.5 rounded bg-zinc-800 text-zinc-300 font-semibold uppercase text-[11px] border border-zinc-700/60">
          {book.category}
        </span>
        {
          book.year && (
            <span class="flex items-center gap-1 text-zinc-400">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg>
              <span>{book.year}</span>
            </span>
          )
        }
        {
          book.rating && (
            <span class="flex items-center gap-1 text-amber-400 font-bold">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg>
              <span>{book.rating}</span>
            </span>
          )
        }
        {
          book.status === 'reading' && (
            <span class="flex items-center gap-1 text-blue-300 bg-blue-500/10 px-2 py-0.5 rounded border border-blue-500/20">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
              <span>Reading {book.progress ? `(${book.progress})` : ''}</span>
            </span>
          )
        }
        {
          book.priority && book.status === 'want-to-read' && (
            <span class="flex items-center gap-1 text-zinc-400 bg-zinc-800 px-2 py-0.5 rounded border border-zinc-700/50">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path></svg>
              <span>Priority: {book.priority}</span>
            </span>
          )
        }
      </div>

      <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-white">{book.title}</h1>

      <div class="flex items-center justify-between gap-4 text-xs sm:text-sm text-zinc-400">
        <span>by {book.author}</span>
        {
          book.link && (
            <a
              href={book.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-blue-400 hover:text-blue-300 hover:underline"
            >
              <span>External Link</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
            </a>
          )
        }
      </div>
    </header>

    {
      hasBody ? (
        <div class="book-article-content text-sm sm:text-base leading-relaxed text-zinc-300 space-y-4">
          <Content />
        </div>
      ) : (
        <div class="py-12 text-center text-xs text-zinc-500 border border-dashed border-zinc-800 rounded-lg">
          No notes written yet for this book.
        </div>
      )
    }
  </article>
</Layout>
