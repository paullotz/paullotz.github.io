---
import { bookSlug, type AnyBook } from '../lib/books';

interface Props {
  books: AnyBook[];
}

const { books } = Astro.props;
---
{
  books.length > 0 && (
    <div class="w-full mb-8 py-2 px-3.5 rounded-md border border-zinc-800/80 bg-zinc-900/40 text-xs text-zinc-400 flex flex-col gap-1.5">
      {books.map((book) => (
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-zinc-500">Currently reading:</span>
            <a href={`/books/${bookSlug(book)}`} class="text-zinc-200 font-medium hover:text-blue-300 hover:underline transition-colors">
              {book.data.title}
            </a>
            <span class="text-zinc-500 hidden sm:inline">by {book.data.author}</span>
          </div>
        </div>
      ))}
    </div>
  )
}
