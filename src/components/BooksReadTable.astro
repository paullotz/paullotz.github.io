---
import { bookSlug, type Book } from '../lib/books';

interface Props {
  books: Book[];
}

const { books } = Astro.props;
---
<div class="space-y-4" data-filter-root>
  <div class="relative">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
    <input
      type="text"
      data-filter-input
      placeholder="Search finished books and summaries..."
      class="w-full pl-10 pr-3 py-2 text-xs sm:text-sm rounded-lg border border-zinc-800 bg-zinc-900/80 text-white placeholder:text-zinc-500 focus:outline-none focus:border-zinc-600 focus:ring-1 focus:ring-zinc-600 shadow-sm"
    />
  </div>

  <div class="overflow-x-auto border border-zinc-800 rounded-lg">
    <table class="w-full text-left text-xs sm:text-sm">
      <thead class="bg-zinc-900/80 border-b border-zinc-800 text-[11px] uppercase tracking-wider text-zinc-400 font-semibold">
        <tr>
          <th class="py-3 px-4">Book / Title</th>
          <th class="py-3 px-4 hidden sm:table-cell">Author</th>
          <th class="py-3 px-4 hidden md:table-cell">Category</th>
          <th class="py-3 px-4">Rating</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-800/60">
        {
          books.map((book) => (
            <tr
              data-filter-row
              data-search={`${book.data.title} ${book.data.author} ${book.data.category}`.toLowerCase()}
              class="hover:bg-zinc-800/40 cursor-pointer transition-colors group"
            >
              <td class="py-3.5 px-4">
                <a href={`/books/${bookSlug(book)}`} class="block">
                  <div class="font-semibold text-white group-hover:text-blue-300 transition-colors">
                    {book.data.title}
                  </div>
                  <div class="text-xs text-zinc-400 sm:hidden mt-0.5">{book.data.author}</div>
                </a>
              </td>
              <td class="py-3.5 px-4 text-zinc-300 text-xs hidden sm:table-cell">{book.data.author}</td>
              <td class="py-3.5 px-4 text-zinc-400 text-xs hidden md:table-cell">{book.data.category}</td>
              <td class="py-3.5 px-4 whitespace-nowrap">
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-amber-400">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg>
                  <span>{book.data.rating ? `${book.data.rating}` : '5/5'}</span>
                </span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div data-filter-empty class="hidden py-12 text-center text-xs text-zinc-500 border border-dashed border-zinc-800 rounded-lg">
    No books found
  </div>
</div>

<script>
  document.querySelectorAll('[data-filter-root]').forEach((root) => {
    const input = root.querySelector('[data-filter-input]') as HTMLInputElement | null;
    if (!input || input.dataset.wired) return;
    input.dataset.wired = 'true';
    const rows = Array.from(root.querySelectorAll('[data-filter-row]'));
    const empty = root.querySelector('[data-filter-empty]');
    input?.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let visible = 0;
      rows.forEach((row) => {
        const hay = (row as HTMLElement).dataset.search || '';
        const show = !q || hay.includes(q);
        (row as HTMLElement).style.display = show ? '' : 'none';
        if (show) visible++;
      });
      empty?.classList.toggle('hidden', visible !== 0);
    });
  });
</script>
