---
import { articleSlug, type Article } from '../lib/books';

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
---
<div class="space-y-4" data-filter-root>
  {
    articles.length > 0 ? (
      <>
        <div class="relative">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
          <input
            type="text"
            data-filter-input
            placeholder="Search articles..."
            class="w-full pl-10 pr-3 py-2 text-xs sm:text-sm rounded-lg border border-zinc-800 bg-zinc-900/80 text-white placeholder:text-zinc-500 focus:outline-none focus:border-zinc-600 focus:ring-1 focus:ring-zinc-600 shadow-sm"
          />
        </div>

        <div class="overflow-x-auto border border-zinc-800 rounded-lg">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-zinc-900/80 border-b border-zinc-800 text-[11px] uppercase tracking-wider text-zinc-400 font-semibold">
              <tr>
                <th class="py-3 px-4">Article / Essay</th>
                <th class="py-3 px-4 hidden sm:table-cell">Category</th>
                <th class="py-3 px-4 hidden md:table-cell">Read Time</th>
                <th class="py-3 px-4 text-right sm:text-left">Date</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-800/60">
              {articles.map((article) => (
                <tr
                  data-filter-row
                  data-search={`${article.data.title} ${article.data.subtitle || ''} ${article.data.category} ${article.data.tags.join(' ')}`.toLowerCase()}
                  class="hover:bg-zinc-800/40 cursor-pointer transition-colors group"
                >
                  <td class="py-3.5 px-4">
                    <a href={`/articles/${articleSlug(article)}`} class="block">
                      <div class="font-semibold text-white group-hover:text-blue-300 transition-colors">
                        {article.data.title}
                      </div>
                      {article.data.subtitle && (
                        <div class="text-xs text-zinc-400 line-clamp-1 mt-0.5 font-normal">
                          {article.data.subtitle}
                        </div>
                      )}
                    </a>
                  </td>
                  <td class="py-3.5 px-4 text-xs text-blue-300 hidden sm:table-cell">
                    #{article.data.category}
                  </td>
                  <td class="py-3.5 px-4 text-xs text-zinc-400 hidden md:table-cell">
                    <span class="inline-flex items-center gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 text-zinc-500"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                      {article.data.readTime}
                    </span>
                  </td>
                  <td class="py-3.5 px-4 text-xs text-zinc-400 text-right sm:text-left whitespace-nowrap">
                    {article.data.publishedDate}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div data-filter-empty class="hidden py-12 text-center text-xs text-zinc-500 border border-dashed border-zinc-800 rounded-lg">
          No articles found
        </div>
      </>
    ) : (
      <div class="py-16 text-center border border-dashed border-zinc-800 rounded-xl bg-zinc-900/30 p-8 space-y-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-zinc-600 mx-auto"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path></svg>
        <h3 class="text-sm font-semibold text-zinc-300">No articles published yet</h3>
        <p class="text-xs text-zinc-500 max-w-sm mx-auto">
          Technical essays and writeups on systems and software engineering will appear here as they are written.
        </p>
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll('[data-filter-root]').forEach((root) => {
    const input = root.querySelector('[data-filter-input]') as HTMLInputElement | null;
    if (!input || input.dataset.wired) return;
    input.dataset.wired = 'true';
    const rows = Array.from(root.querySelectorAll('[data-filter-row]'));
    const empty = root.querySelector('[data-filter-empty]');
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let visible = 0;
      rows.forEach((row) => {
        const hay = (row as HTMLElement).dataset.search || '';
        const show = !q || hay.includes(q);
        (row as HTMLElement).style.display = show ? '' : 'none';
        if (show) visible++;
      });
      empty?.classList.toggle('hidden', visible !== 0);
    });
  });
</script>
