---
import MoonComicIcon from './MoonComicIcon.astro';

interface Props {
  activeTab: 'books' | 'articles';
  booksCount: number;
  articlesCount: number;
}

const { activeTab, booksCount, articlesCount } = Astro.props;

const booksCls =
  activeTab === 'books'
    ? 'bg-zinc-800 text-white font-semibold shadow-sm border border-zinc-700/60'
    : 'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/40';
const articlesCls =
  activeTab === 'articles'
    ? 'bg-zinc-800 text-white font-semibold shadow-sm border border-zinc-700/60'
    : 'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/40';
---
<header class="sticky top-4 z-40 mb-6 max-w-[880px] mx-auto w-full">
  <nav
    id="site-nav"
    class="px-3 sm:px-4 py-2 flex items-center justify-between gap-2 sm:gap-4 text-xs sm:text-sm rounded-full border transition-all duration-300 nav-pill nav-pill--top"
  >
    <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
      <a
        href="/"
        class="flex items-center gap-2 font-bold tracking-tight text-white hover:text-zinc-300 transition-colors pr-2 group"
      >
        <MoonComicIcon className="w-5 h-5 group-hover:rotate-12 transition-transform duration-200" />
        <span>Paul L.</span>
      </a>

      <span class="text-zinc-700 select-none hidden sm:inline mr-1">|</span>

      <a href="/" class={`px-3 py-1 rounded-full transition-all ${booksCls}`}>
        <span>Books</span>
        <span class="ml-1.5 text-[11px] text-zinc-400">({booksCount})</span>
      </a>

      <a href="/articles" class={`px-3 py-1 rounded-full transition-all ${articlesCls}`}>
        <span>Articles</span>
        <span class="ml-1.5 text-[11px] text-zinc-400">({articlesCount})</span>
      </a>
    </div>
  </nav>
</header>

<script>
  const nav = document.getElementById('site-nav');
  const onScroll = () => {
    if (!nav) return;
    const scrolled = window.scrollY > 10;
    nav.classList.toggle('nav-pill--scrolled', scrolled);
    nav.classList.toggle('nav-pill--top', !scrolled);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
