---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  activeTab: 'books' | 'articles';
  booksCount: number;
  articlesCount: number;
}

const {
  title = 'Paul L. | Books & Articles',
  description = 'Personal library, book notes, and technical articles on systems and software engineering.',
  activeTab,
  booksCount,
  articlesCount,
} = Astro.props;
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Plus Jakarta Sans & IBM Plex Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph for Social & Chat previews -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://paullotz.github.io/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://paullotz.github.io/og-image.png" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://paullotz.github.io/" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://paullotz.github.io/og-image.png" />
  </head>
  <body>
    <div class="min-h-screen py-6 px-4 sm:px-8 flex flex-col font-sans bg-[#121217] text-[#e4e4e7]">
      <div class="w-full max-w-[880px] mx-auto flex-grow flex flex-col">
        <SiteNav activeTab={activeTab} booksCount={booksCount} articlesCount={articlesCount} />
        <main class="flex-grow">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>
